{
  "permissions": {
    "allow": [
      "Bash(./scripts/check-tools.sh)",
      "Bash(./scripts/safety-scan.sh)",
      "Bash(./scripts/check-evidence-names.sh)",
      "Bash(./scripts/check-agents-sync.sh)",
      "Bash(./scripts/preflight.sh)",
      "Bash(./scripts/hash-artifacts.sh:*)",
      "Bash(./scripts/verify-hashes.sh:*)",
      "Bash(./scripts/inventory-ipsw.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/guard-write.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/post-safety-scan.sh"
          }
        ]
      }
    ]
  }
}
